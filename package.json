{
    "name": "clippy-action",
    "description": "🐻‍❄️📦 GitHub action to run Clippy, an up-to-date and modern version of actions-rs/clippy",
    "version": "1.5.0",
    "private": true,
    "type": "module",
    "main": "dist/index.js",
    "author": "step-security",
    "license": "Apache-2.0",
    "repository": "https://github.com/step-security/clippy-action",
    "bugs": "https://github.com/step-security/clippy-action/issues/new",
    "scripts": {
        "build": "ncc build src/main.ts -o dist --minify",
        "test": "bun test",
        "all": "npm run fmt && npm run lint && npm run build",
        "check": "prettier --check **/*.{js,ts,json,yml,yaml,md}",
        "lint": "eslint --format codeframe --exit-on-fatal-error --stats .",
        "fmt": "prettier --write **/*.{js,ts,json,yml,yaml,md}"
    },
    "dependencies": {
        "@actions/core": "^2.0.0",
        "@actions/exec": "^3.0.0",
        "@actions/github": "^8.0.0",
        "@actions/io": "^1.1.3",
        "@noelware/utils": "^2.5.1",
        "axios": "^1.12.0"
    },
    "devDependencies": {
        "@augu/tsconfig": "^1.2.0",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@types/bun": "^1.3.10",
        "@types/eslint": "^9.6.1",
        "@types/node": "^25.5.0",
        "@types/prettier": "^3.0.0",
        "@typescript-eslint/eslint-plugin": "^8.57.0",
        "@typescript-eslint/parser": "^8.57.0",
        "@vercel/ncc": "^0.45.0",
        "eslint": "^10.0.3",
        "eslint-config-prettier": "^10.1.8",
        "eslint-formatter-codeframe": "^7.32.2",
        "prettier": "^3.8.1",
        "typescript": "^5.9.3"
    }
}
